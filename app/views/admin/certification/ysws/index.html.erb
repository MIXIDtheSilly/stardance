<% content_for :title, "YSWS Review Queue" %>

<main class="ysws-queue" role="main">
  <h1>YSWS Review Queue</h1>

  <%= turbo_frame_tag "ysws_dashboard", src: admin_certification_ysws_dashboard_path, loading: "lazy" do %>
    <p class="ysws-dashboard__loading">Loading reviewer stats…</p>
  <% end %>

  <%# The project-type select and the integrity toggle live outside this form —
      in the table header and the summary row respectively — and associate back
      to it via their form="ysws-queue-filters" attribute. %>
  <%= form_with url: admin_certification_ysws_reviews_path, method: :get,
                id: "ysws-queue-filters", class: "ysws-queue__filters" do %>
    <% if @sort %>
      <%= hidden_field_tag :sort, @sort %>
      <%= hidden_field_tag :dir, @dir %>
    <% end %>

    <%# Both paths to locked in: holding either the devlog or the project average
        clears it, so the widget shows both figures and reads its state off both. %>
    <% if @devlog_pace %>
      <% locked_in = ::Certification::Ysws.locked_in?(devlog_pace: @devlog_pace, project_pace: @project_pace) %>
      <%= tag.div class: [ "ysws-queue__goal", ("ysws-queue__goal--locked-in" if locked_in) ],
                  role: "status", aria: { live: "polite" } do %>
        <div class="ysws-queue__goal-paces">
          <div class="ysws-queue__goal-primary">
            <span class="ysws-queue__goal-count">
              <%= number_with_precision @devlog_pace[:daily_average], precision: 1, strip_insignificant_zeros: true %>
            </span>
            <span class="ysws-queue__goal-label">devlogs / day this week</span>
          </div>

          <div class="ysws-queue__goal-primary">
            <span class="ysws-queue__goal-count">
              <%= number_with_precision @project_pace[:daily_average], precision: 1, strip_insignificant_zeros: true %>
            </span>
            <span class="ysws-queue__goal-label">projects / day this week</span>
          </div>
        </div>

        <span class="ysws-queue__goal-note">
          <% if @devlog_pace[:needed_today].zero? %>
            Locked in — <%= ::Certification::Ysws::DEVLOG_REVIEW_GOAL_PER_DAY %> devlogs/day average met
          <% elsif @project_pace[:needed_today].zero? %>
            Locked in — <%= ::Certification::Ysws::PROJECT_REVIEW_GOAL_PER_DAY %> projects/day average met
          <% else %>
            <%= @devlog_pace[:needed_today] %> more devlogs
            or <%= @project_pace[:needed_today] %> more projects today to lock in!
          <% end %>
        </span>
      <% end %>
    <% end %>

    <%# Reset filters, hidden from the UI for now. %>
    <%# if @project_type.present? || @sort.present? || !@with_integrity %>
    <%#   link_to "Reset filters", admin_certification_ysws_reviews_path(reset_filters: 1), class: "btn-secondary slim ysws-queue__reset-filters" %>
    <%# end %>
  <% end %>

  <%= render "queue_table" %>
</main>
